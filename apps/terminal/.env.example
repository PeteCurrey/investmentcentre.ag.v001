# MERIDIAN TERMINAL - ENVIRONMENT CONFIGURATION TEMPLATE

# Supabase Database Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-service-role-key

# OANDA Broker API Credentials
OANDA_API_KEY=your-oanda-api-key
OANDA_ACCOUNT_ID=101-004-39906540-001
OANDA_ENVIRONMENT=practice # 'practice' or 'live'

# Security & Risk Verification Secrets (min 32 chars)
CONSOLE_SESSION_SECRET=your-session-secret-at-least-32-characters-long
CRON_SECRET=your-cron-secret-at-least-32-characters-long
RISK_HMAC_SECRET=your-risk-hmac-secret-at-least-32-characters-long

# Execution Safety Second Lock (MUST BE false AT REST)
# TIER_4_ENABLED ships false at config level, enabled ONLY when deliberately going LIVE.
TIER_4_ENABLED=false
