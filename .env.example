# MERIDIAN Platform — Environment Variable Reference
#
# This file documents EVERY required and optional environment variable used in
# the platform. It contains NAMES and DESCRIPTIONS ONLY. Do not commit values,
# real keys, tokens, or secrets — even as placeholder examples.
#
# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored and will never be committed.
#
# Rule: Every env var that controls security-critical behaviour uses
#   === 'true'   (fail-closed — unset or any other value is treated as disabled)

# ── Supabase ──────────────────────────────────────────────────────────────────

# Supabase project URL (public — used by Next.js frontend)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anonymous key (public — used by Next.js frontend)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase project URL (server-side usage)
SUPABASE_URL=

# Supabase anonymous key (server-side usage)
SUPABASE_ANON_KEY=

# Supabase service role / secret key (server-side only — never expose to client)
SUPABASE_SECRET_KEY=

# Supabase direct database connection URL (for migrations and raw SQL access)
SUPABASE_DB_URL=

# ── AI Council & Co-Pilot ─────────────────────────────────────────────────────

# Anthropic API key — required for Claude Council seat (claude-sonnet-4-6)
# and Trade page AI Co-Pilot
ANTHROPIC_API_KEY=

# OpenAI API key — required for GPT-4o Council seat
OPENAI_API_KEY=

# xAI API key — required for Grok Council seat
XAI_API_KEY=

# ── OANDA Broker Integration ──────────────────────────────────────────────────

# OANDA REST API token
OANDA_API_KEY=

# OANDA account ID for order submission and account state queries
OANDA_ACCOUNT_ID=

# OANDA environment: 'practice' or 'live'
OANDA_ENVIRONMENT=

# ── Risk Gate ─────────────────────────────────────────────────────────────────

# HMAC secret for ApprovalToken signing — minimum 32 characters
# Used by RiskGate.verifyToken to validate order intent signatures
RISK_HMAC_SECRET=

# ── Kill Switches (fail-closed — must be exactly 'true' to enable) ────────────

# Enables live order submission tier 4 flow — must be exactly 'true'
TIER_4_ENABLED=

# ── Data Source API Keys ──────────────────────────────────────────────────────

# FRED Macroeconomic Data (St. Louis Fed)
FRED_API_KEY=

# Twelve Data financial markets (multi-asset prices)
TWELVE_DATA_API_KEY=

# Finnhub market data and fundamentals
FINNHUB_API_KEY=

# US Energy Information Administration (EIA)
EIA_API_KEY=

# UK Companies House
COMPANIES_HOUSE_API_KEY=

# OpenCorporates entity registry (unbuilt in Wave 1 — register for later)
# OPENCORPORATES_API_KEY=

# ── Logging ───────────────────────────────────────────────────────────────────

# Structured logger minimum level: debug | info | warn | error (default: info)
LOG_LEVEL=

# ── Autotrader Worker (packages/autotrader) ───────────────────────────────────

# OANDA account ID for the autotrader worker (may differ from terminal account)
AUTOTRADER_ACCOUNT_ID=

# Iceberg access token (if applicable to autotrader deployment)
ICEBERG_TOKEN=
