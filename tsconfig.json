{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": [
      "ES2022"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "paths": {
      "@meridian/adapters": [
        "./packages/adapters/src/index.ts"
      ],
      "@meridian/automation": [
        "./packages/automation/src/index.ts"
      ],
      "@meridian/brief": [
        "./packages/brief/src/index.ts"
      ],
      "@meridian/core": [
        "./packages/core/src/index.ts"
      ],
      "@meridian/council": [
        "./packages/council/src/index.ts"
      ],
      "@meridian/delta": [
        "./packages/delta/src/index.ts"
      ],
      "@meridian/edge": [
        "./packages/edge/src/index.ts"
      ],
      "@meridian/execute": [
        "./packages/execute/src/index.ts"
      ],
      "@meridian/horizon": [
        "./packages/horizon/src/index.ts"
      ],
      "@meridian/registry": [
        "./packages/registry/src/index.ts"
      ],
      "@meridian/resolve": [
        "./packages/resolve/src/index.ts"
      ],
      "@meridian/risk": [
        "./packages/risk/src/index.ts"
      ],
      "@meridian/salience": [
        "./packages/salience/src/index.ts"
      ],
      "@meridian/signals": [
        "./packages/signals/src/index.ts"
      ],
      "@meridian/ui": [
        "./packages/ui/src/index.ts"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts"
  ]
}
